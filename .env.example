[TEMPLATE]
# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_lead_agent

# Auth.js — minimum 32 chars random string: https://generate-secret.vercel.app/32
AUTH_SECRET=

# Frontend origin allowed to call the API with credentials
CORS_ORIGIN=http://localhost:3000

# Shared rate-limit store (step 36) — Upstash REST credentials. When BOTH are
# set, express-rate-limit counters live in Upstash Redis: they survive restarts
# and are shared across instances. Blank (dev/tests) keeps the per-process
# in-memory store. Create a database at https://console.upstash.com → REST tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many reverse-proxy hops terminate the client's connection before the API
# (step 36). Trusting everything would let a client forge X-Forwarded-For and
# dodge the per-IP limits. Default: 1 in production, 0 otherwise — override to
# match the deployment topology (a direct server: 0).
TRUST_PROXY_HOPS=

# Anonymous /auth routes are rate limited to blunt credential stuffing
# (step 36). Budgets are per IP per window, env-tunable for deployment tuning.
AUTH_RATE_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT=20
AUTH_REGISTER_RATE_LIMIT=10

# AI agent (IMPLEMENTATION_PLAN step 20)
# AI_PROVIDER: auto | disabled | openrouter | openai-compatible.
# auto prefers OpenRouter when OPENROUTER_API_KEY is set, then the generic
# OpenAI-compatible provider when AI_API_KEY is set, else stays disabled.
AI_PROVIDER=auto

# OpenRouter (https://openrouter.ai/settings/keys).
# Get a key, then set AI_PROVIDER=openrouter (or leave it on auto).
OPENROUTER_API_KEY=
# Any OpenRouter model id; the `:free` suffix selects a free model.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Generic OpenAI-compatible provider (optional fallback).
# Leave AI_API_KEY empty to keep that path disabled (it will not fabricate replies).
AI_API_KEY=
# Any OpenAI-compatible /chat/completions endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Shared agent limits, used by whichever provider is active.
AI_MAX_OUTPUT_TOKENS=600
AI_TEMPERATURE=0.3
AI_HISTORY_LIMIT=20

# Lead scoring rules (FEATURES §18, IMPLEMENTATION_PLAN step 23).
# Deterministic point weights — the backend always computes the score from
# these rules, never the model. Defaults sum to the LEAD_SCORE_MAX ceiling.
LEAD_SCORE_SERVICE=20
LEAD_SCORE_AREA=15
LEAD_SCORE_URGENCY_HIGH=15
LEAD_SCORE_URGENCY_MEDIUM=8
LEAD_SCORE_URGENCY_LOW=4
LEAD_SCORE_APPOINTMENT=15
LEAD_SCORE_INFORMATION=5
LEAD_SCORE_BUDGET=15
LEAD_SCORE_PHONE=10
LEAD_SCORE_EMAIL=5
LEAD_SCORE_MAX=100

# Booking / availability (FEATURES §35, IMPLEMENTATION_PLAN step 27).
# Slots are generated from the business's own opening hours.
BOOKING_DEFAULT_DURATION=60
BOOKING_MIN_DURATION=15
BOOKING_MAX_RANGE_DAYS=62

# Paddle billing (Phase H). `PADDLE_ENV` is required and has no default — the
# process must never silently run against the wrong Paddle account.
# PADDLE_ENV: sandbox | live.
PADDLE_ENV=
# API key for the environment above (sandbox keys are prefixed `pdl_sdbx_`,
# live keys `pdl_live_`). Only the active environment's key is needed.
PADDLE_SANDBOX_API_KEY=
PADDLE_LIVE_API_KEY=
# Notification destination signing secret for the environment above
# (Paddle dashboard > Paddle > Events > Notifications > your destination).
# This is NOT the API key.
PADDLE_WEBHOOK_SANDBOX_SECRET=
PADDLE_WEBHOOK_LIVE_SECRET=

# Default platform administrator (IMPLEMENTATION_PLAN step 28).
# `npm run db:seed` creates the account, or re-asserts the role on one that
# already exists (an existing password is never rewritten). ADMIN_PASSWORD is
# mandatory when NODE_ENV=production — the development default is refused there.
ADMIN_EMAIL=admin@leadza.com
ADMIN_PASSWORD=
ADMIN_NAME=Leadza Admin
