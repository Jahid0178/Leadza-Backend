# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_lead_agent

# Auth.js — minimum 32 chars random string: https://generate-secret.vercel.app/32
AUTH_SECRET=

# Frontend origin allowed to call the API with credentials
CORS_ORIGIN=http://localhost:3000
