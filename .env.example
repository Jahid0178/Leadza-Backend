[TEMPLATE]
# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_lead_agent

# Auth.js — minimum 32 chars random string: https://generate-secret.vercel.app/32
AUTH_SECRET=

# Frontend origin allowed to call the API with credentials
CORS_ORIGIN=http://localhost:3000

# AI agent (IMPLEMENTATION_PLAN step 20)
# AI_PROVIDER: auto | disabled | openrouter | openai-compatible.
# auto prefers OpenRouter when OPENROUTER_API_KEY is set, then the generic
# OpenAI-compatible provider when AI_API_KEY is set, else stays disabled.
AI_PROVIDER=auto

# OpenRouter (https://openrouter.ai/settings/keys).
# Get a key, then set AI_PROVIDER=openrouter (or leave it on auto).
OPENROUTER_API_KEY=
# Any OpenRouter model id; the `:free` suffix selects a free model.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Generic OpenAI-compatible provider (optional fallback).
# Leave AI_API_KEY empty to keep that path disabled (it will not fabricate replies).
AI_API_KEY=
# Any OpenAI-compatible /chat/completions endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Shared agent limits, used by whichever provider is active.
AI_MAX_OUTPUT_TOKENS=600
AI_TEMPERATURE=0.3
AI_HISTORY_LIMIT=20

# Lead scoring rules (FEATURES §18, IMPLEMENTATION_PLAN step 23).
# Deterministic point weights — the backend always computes the score from
# these rules, never the model. Defaults sum to the LEAD_SCORE_MAX ceiling.
LEAD_SCORE_SERVICE=20
LEAD_SCORE_AREA=15
LEAD_SCORE_URGENCY_HIGH=15
LEAD_SCORE_URGENCY_MEDIUM=8
LEAD_SCORE_URGENCY_LOW=4
LEAD_SCORE_APPOINTMENT=15
LEAD_SCORE_INFORMATION=5
LEAD_SCORE_BUDGET=15
LEAD_SCORE_PHONE=10
LEAD_SCORE_EMAIL=5
LEAD_SCORE_MAX=100
