// AI Lead Response Agent — initial schema (auth + tenancy foundation)
// Doc ref: agent.md §12 (Database), §6 (Authorization), §Platform Administration

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform-level role. Separate from business membership (agent.md §Platform Administration).
enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

/// Business membership role (agent.md §6).
enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum PriceType {
  FIXED
  FROM
  FREE
  CUSTOM
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum KnowledgeEntryType {
  FAQ
  BUSINESS
}

/// Lead lifecycle (FEATURES §15, agent.md §19). The backend owns the
/// transition table between these — the frontend may never jump states.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFYING
  QUALIFIED
  BOOKED
  WON
  LOST
  SPAM
  CANCELLED
}

/// Where a lead originated (FEATURES §16). Lets businesses measure which
/// channels generate results.
enum LeadSource {
  WEBSITE
  WHATSAPP
  EMAIL
  SMS
  FACEBOOK
  INSTAGRAM
}

/// How soon the customer needs help (FEATURES §17 example: "Urgency: High").
enum LeadUrgency {
  LOW
  MEDIUM
  HIGH
}

/// Conversation lifecycle (FEATURES §19, §31). The backend owns the
/// transitions between these — the frontend may never jump states.
enum ConversationStatus {
  AI_ACTIVE
  HUMAN_REQUESTED
  HUMAN_ACTIVE
  CLOSED
}

/// Channel a conversation arrived on (FEATURES §19, §38).
enum ConversationChannel {
  WEBSITE
  WHATSAPP
  EMAIL
  SMS
  FACEBOOK
  INSTAGRAM
}

/// Booking lifecycle (FEATURES §35, IMPLEMENTATION_PLAN step 27). The backend
/// owns the transitions between these — the frontend may never jump states.
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Who created a booking: the AI agent or a staff member (§35).
enum BookingOrigin {
  AI
  STAFF
}

/// Who wrote a message (FEATURES §20).
enum MessageSender {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

/// Outcome of one AI tool call (IMPLEMENTATION_PLAN step 21 ledger).
/// DENIED = the backend refused it (unknown tool, bad args, another tenant's
/// resource); ERROR = the handler itself threw.
enum AiToolCallStatus {
  OK
  DENIED
  ERROR
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String?
  platformRole   PlatformRole @default(USER)
  status         UserStatus   @default(ACTIVE)
  emailVerified  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships BusinessMember[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  createdBookings Booking[] @relation("BookingCreator")

  @@map("users")
}

model Business {
  id         String         @id @default(cuid())
  name       String
  /// Free-text business type ("Plumber", "Electrician", …) — FEATURES §8.
  type       String?
  website    String?
  phone      String?
  email      String?
  address    String?
  description String?
  /// Presentation settings so the platform works in any country (§15, §30).
  /// ISO 4217 currency used to format money (lead budget, service prices).
  currency   String         @default("GBP")
  /// BCP-47 locale used to format dates, times and numbers.
  locale     String         @default("en-GB")
  /// IANA timezone used to render timestamps in the business's local time.
  timezone   String         @default("Europe/London")
  /// Coordinates from the chosen Nominatim suggestion (null for typed-only addresses).
  latitude   Float?
  longitude  Float?
  status     BusinessStatus @default(ACTIVE)
  /// Set when the owner finishes the onboarding flow; null = resume it (§9).
  onboardingCompletedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  members   BusinessMember[]
  services  Service[]
  areas     ServiceArea[]
  hours     BusinessHour[]
  knowledge KnowledgeEntry[]
  customers Customer[]
  leads     Lead[]
  conversations Conversation[]
  aiToolCalls AiToolCall[]
  aiUsage   AiUsage[]
  bookings  Booking[]
  /// Paddle billing account for this tenant (Phase H).
  billingCustomer PaddleCustomer?
  subscriptions   Subscription[]

  @@map("businesses")
}

/// Verified multi-tenancy link: user ↔ business (agent.md §6, §13).
model BusinessMember {
  id         String     @id @default(cuid())
  businessId String
  userId     String
  role       MemberRole
  createdAt  DateTime   @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

/// A service the business offers (FEATURES §10).
model Service {
  id          String     @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Float?
  priceType   PriceType  @default(FIXED)
  duration    Int?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads    Lead[]
  bookings Booking[]

  @@index([businessId])
  @@map("services")
}

/// A place the business serves (FEATURES §11).
model ServiceArea {
  id         String   @id @default(cuid())
  businessId String
  /// Normalized label, e.g. a postcode, town, city, or area name.
  value      String
  label      String?
  /// Optional serving radius in kilometers when the area is radius-based.
  radiusKm   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, value])
  @@index([businessId])
  @@map("service_areas")
}

/// Business opening hours (FEATURES §12).
model BusinessHour {
  id          String    @id @default(cuid())
  businessId  String
  weekday     Weekday
  /// Start of the first range, e.g. "08:00".
  startTime   String
  /// End of the last range, e.g. "18:00".
  endTime     String
  /// Multiple non-overlapping ranges can be modeled with separate rows per business/day.
  orderIndex  Int       @default(0)
  closed      Boolean   @default(false)
  emergency   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekday, orderIndex])
  @@index([businessId])
  @@map("business_hours")
}

/// A person who enquired about the business's services (FEATURES §14).
/// The same customer may have multiple leads over time; find-or-create is
/// keyed on (businessId, phone) or (businessId, email).
model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  postcode   String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads    Lead[]
  conversations Conversation[]
  bookings Booking[]

  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("customers")
}

/// A potential customer enquiry (FEATURES §15, agent.md §19–20).
/// Status transitions are validated in the backend against the lifecycle
/// table — the frontend may never jump a lead to an arbitrary state.
model Lead {
  id         String     @id @default(cuid())
  businessId String
  customerId String
  /// Optional: the enquiry may name no specific service yet.
  serviceId  String?
  status     LeadStatus @default(NEW)
  source     LeadSource @default(WEBSITE)
  urgency    LeadUrgency?
  /// Free-text town/city the job is at (§15).
  location   String?
  postcode   String?
  /// Budget the customer mentioned, in the business's currency (§15, §17).
  budget          Float?
  /// Preferred appointment date/time as captured (§15, §17).
  preferredDate DateTime?
  preferredTime String?
  /// The customer's original message (agent.md §20).
  customerMessage String?
  /// Rule-based score 0-100 (§18, step 23); null until scored.
  leadScore  Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  aiToolCalls AiToolCall[]
  bookings Booking[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, customerId])
  /// Platform analytics bucket leads by creation day (§51).
  @@index([createdAt])
  @@map("leads")
}

/// Business knowledge entries (FEATURES §13).
/// `isActive` = Published (true) / Draft (false); `archivedAt` set = archived
/// and hidden from the dashboard list, so a draft is never an archive.
model KnowledgeEntry {
  id         String             @id @default(cuid())
  businessId String
  question   String
  answer     String
  type       KnowledgeEntryType @default(FAQ)
  category   String             @default("FAQ")
  tags       String[]           @default([])
  isActive   Boolean            @default(true)
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("knowledge_entries")
}

/// A customer interaction thread (FEATURES §19, IMPLEMENTATION_PLAN step 15).
/// Every enquiry belongs to a conversation; the backend owns the status
/// transitions (AI ↔ human ↔ closed) — the frontend may never jump states.
model Conversation {
  id           String              @id @default(cuid())
  businessId   String
  customerId   String
  /// Optional: a conversation may exist before/without a lead.
  leadId       String?
  channel      ConversationChannel @default(WEBSITE)
  status       ConversationStatus  @default(AI_ACTIVE)
  /// Staff member who took the thread over (FEATURES §31 "Assigned staff").
  assignedToId String?
  /// Public chat access token (FEATURES §22, IMPLEMENTATION_PLAN step 19).
  /// Set only for conversations started from the website chat widget; the
  /// widget proves ownership of its thread with this opaque value so no other
  /// visitor can read it, and it is never the guessable conversation id.
  publicToken  String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]
  aiToolCalls AiToolCall[]
  aiUsage    AiUsage[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([leadId])
  /// Platform analytics bucket conversations by creation day (§51).
  @@index([createdAt])
  @@map("conversations")
}

/// A single message in a conversation (FEATURES §20).
/// `aiGenerated` distinguishes AI replies from staff replies even though
/// both use sender-specific provenance.
model Message {
  id                String              @id @default(cuid())
  conversationId    String
  sender            MessageSender
  content           String
  channel           ConversationChannel @default(WEBSITE)
  aiGenerated       Boolean             @default(false)
  /// Provider id for idempotent channel webhooks (§36, §39); null for native.
  externalMessageId String?
  createdAt         DateTime            @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

/// Debug ledger for AI tool calls (IMPLEMENTATION_PLAN step 21, agent.md §16).
/// Every tool the agent invokes is recorded with its arguments, the safe
/// result (or error) and the outcome, so a bad reply can be traced back to the
/// backend decision that produced it. The model never writes here directly —
/// only the tool executor does, through the backend's own validation.
model AiToolCall {
  id             String           @id @default(cuid())
  businessId     String
  conversationId String
  /// Null when the conversation has no linked lead (or the tool targets none).
  leadId         String?
  /// Tool name, e.g. "updateLead".
  tool           String
  status         AiToolCallStatus
  /// Arguments the model supplied (parsed from its JSON), recorded for debug.
  arguments      Json?
  /// Safe, model-facing result payload.
  result         Json?
  /// Safe error message when status is DENIED or ERROR.
  error          String?
  createdAt      DateTime         @default(now())

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([conversationId])
  @@index([tool])
  @@map("ai_tool_calls")
}

/// AI usage tracking (FEATURES §49, IMPLEMENTATION_PLAN step 32).
/// One row per agent run: provider, model, the tokens the run consumed (summed
/// across its tool rounds) and the USD cost — the provider's own reported cost
/// when it returns one, otherwise the estimate from `agents/usage.ts`.
/// Internal cost monitoring only: this is the vendor's cost, never what a
/// business is billed, and it is exposed to platform admins only.
model AiUsage {
  id             String   @id @default(cuid())
  businessId     String
  conversationId String
  provider       String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  /// USD. Provider-reported when available, otherwise a price-table estimate;
  /// 0 for an unpriced model rather than a guess.
  estimatedCost  Float    @default(0)
  createdAt      DateTime @default(now())

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_usage")
}

/// A scheduled appointment (FEATURES §35, IMPLEMENTATION_PLAN step 27).
/// Availability comes from the business's own hours (and, later, a connected
/// calendar) — the AI may never offer a time no source reports (§25, §34).
/// A partial unique index on (business_id, start_at) for active statuses stops
/// a race from double-booking the same slot; it is added in the migration.
model Booking {
  id          String        @id @default(cuid())
  businessId  String
  customerId  String
  /// Optional: a booking may not be tied to a lead.
  leadId      String?
  serviceId   String?
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(PENDING)
  origin      BookingOrigin @default(STAFF)
  notes       String?
  /// Staff member who created it (null for AI-created bookings).
  createdById String?
  cancelledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, startAt])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([leadId])
  /// Platform analytics count bookings by creation day (§51).
  @@index([createdAt])
  @@map("bookings")
}

/// One sensitive platform action (FEATURES §45, IMPLEMENTATION_PLAN step 29):
/// business suspended/restored, user suspended/restored, platform role
/// changed, … Written by the platform admin area only.
///
/// Deliberate choices:
///   - no relations and a denormalized `actorEmail`: an audit entry must
///     outlive the user or business it names, so nothing here can cascade.
///   - `action` / `resourceType` are strings, not enums: a new audited action
///     (subscriptions, integrations, impersonation in Phase H) must not need
///     a migration, and the allowed values live in the TS union in
///     `src/services/audit.service.ts`.
///   - there is no update or delete path in any API: history is append-only
///     (§45 "audit history should not be editable through the normal UI").
model AuditLog {
  id           String   @id @default(cuid())
  /// The platform administrator who acted (User id, no relation).
  actorId      String
  /// Snapshot of the actor's email at the time of the action.
  actorEmail   String
  /// AuditAction, e.g. "business.suspended".
  action       String
  /// Resource kind, e.g. "business" | "user".
  resourceType String
  resourceId   String
  /// Tenant the action touched; null for platform-level actions.
  businessId   String?
  /// Action-specific detail, e.g. { from: "ACTIVE", to: "SUSPENDED" }.
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([businessId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@map("audit_logs")
}

/// One recorded application event feeding platform analytics (FEATURES §51,
/// step 33b "Admin analytics"). Written best-effort at the exact state-change
/// site of the flow that produced it (lead status moves, conversation
/// escalations, failed agent runs) — never by any separate "analytics pass".
///
/// Deliberate choices (mirroring AuditLog):
///   - no relations: an event must outlive the lead/conversation it names,
///     so nothing here can cascade;
///   - `fromStatus` / `toStatus` are plain strings: event kinds never add
///     columns and old rows never need re-writing;
///   - `metadata` carries small non-sensitive context only (handoff reason,
///     provider name) — never message contents or credentials;
///   - there is no update or delete path in any API: append-only, so a
///     retried flow re-reading its own pre-condition never double-fires
///     (transition guards make the second attempt a no-op, not a new event).
model AnalyticsEvent {
  id             String             @id @default(cuid())
  type           AnalyticsEventType
  businessId     String
  /// The lead the event is about, when one exists.
  leadId         String?
  /// The conversation the event is about, when one exists.
  conversationId String?
  /// Previous status, for *_STATUS_CHANGED events.
  fromStatus     String?
  /// New status, for *_*_CHANGED / escalated events.
  toStatus       String?
  /// Who produced a CONVERSATION_ESCALATED: "AI" (handoff tool) or "STAFF".
  initiator      String?
  /// Event-specific detail, e.g. { provider, reason } for AI_RUN_FAILED.
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([type, createdAt])
  @@index([businessId, createdAt])
  @@index([conversationId])
  @@index([leadId])
  @@map("analytics_events")
}

/// Event kinds recorded for platform analytics (FEATURES §51). Channel kinds
/// are reserved now so the steps 34–35 webhook work can adopt them without
/// touching this schema again.
enum AnalyticsEventType {
  BUSINESS_REGISTERED
  LEAD_STATUS_CHANGED
  CONVERSATION_ESCALATED
  AI_RUN_FAILED
  CHANNEL_INTEGRATION_FAILED
  CHANNEL_INTEGRATION_RECOVERED
}

/// Paddle billing customer (IMPLEMENTATION_PLAN Phase H, agent.md §12).
///
/// Named `billing_customers` so it never collides with the existing
/// `customers` table — the business's own end-customers (FEATURES §14).
/// The Paddle id (`ctm_…`) is the primary key, so at-least-once webhook
/// deliveries upsert onto the same row instead of inserting duplicates.
model PaddleCustomer {
  customerId String   @id @map("customer_id")
  email      String
  /// Tenant the paying account belongs to; null until a subscription or
  /// checkout can link it (resolved from custom data or the email owner).
  businessId String?  @unique @map("business_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business      Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]

  @@index([businessId])
  @@map("billing_customers")
}

/// Mirrored Paddle subscription state (IMPLEMENTATION_PLAN Phase H).
///
/// The Paddle id (`sub_…`) is the primary key, so out-of-order and duplicate
/// deliveries converge on one row. Access is decided from `status` alone —
/// a scheduled change never revokes access; only `canceled` does.
model Subscription {
  subscriptionId        String    @id @map("subscription_id")
  customerId            String    @map("customer_id")
  /// Tenant this subscription grants access to; null until linked.
  businessId            String?   @map("business_id")
  status                String
  priceId               String    @map("price_id")
  productId             String    @map("product_id")
  scheduledChangeAction String?   @map("scheduled_change_action")
  scheduledChangeAt     DateTime? @map("scheduled_change_at")
  /// When Paddle created the subscription — not when we mirrored it. Null on
  /// rows mirrored before this column existed, until their next sync.
  paddleCreatedAt       DateTime? @map("paddle_created_at")
  /// Paddle's next charge/attempt; null once the subscription has no future
  /// bill (canceled). Keeps the admin view honest between notifications.
  nextBilledAt          DateTime? @map("next_billed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  customer PaddleCustomer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  business Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@map("subscriptions")
}
