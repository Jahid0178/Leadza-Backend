// AI Lead Response Agent — initial schema (auth + tenancy foundation)
// Doc ref: agent.md §12 (Database), §6 (Authorization), §Platform Administration

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform-level role. Separate from business membership (agent.md §Platform Administration).
enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

/// Business membership role (agent.md §6).
enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum PriceType {
  FIXED
  FROM
  FREE
  CUSTOM
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum KnowledgeEntryType {
  FAQ
  BUSINESS
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String?
  platformRole   PlatformRole @default(USER)
  status         UserStatus   @default(ACTIVE)
  emailVerified  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships BusinessMember[]

  @@map("users")
}

model Business {
  id         String         @id @default(cuid())
  name       String
  /// Free-text business type ("Plumber", "Electrician", …) — FEATURES §8.
  type       String?
  website    String?
  phone      String?
  email      String?
  address    String?
  description String?
  /// Coordinates from the chosen Nominatim suggestion (null for typed-only addresses).
  latitude   Float?
  longitude  Float?
  status     BusinessStatus @default(ACTIVE)
  /// Set when the owner finishes the onboarding flow; null = resume it (§9).
  onboardingCompletedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  members   BusinessMember[]
  services  Service[]
  areas     ServiceArea[]
  hours     BusinessHour[]
  knowledge KnowledgeEntry[]

  @@map("businesses")
}

/// Verified multi-tenancy link: user ↔ business (agent.md §6, §13).
model BusinessMember {
  id         String     @id @default(cuid())
  businessId String
  userId     String
  role       MemberRole
  createdAt  DateTime   @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

/// A service the business offers (FEATURES §10).
model Service {
  id          String     @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Float?
  priceType   PriceType  @default(FIXED)
  duration    Int?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("services")
}

/// A place the business serves (FEATURES §11).
model ServiceArea {
  id         String   @id @default(cuid())
  businessId String
  /// Normalized label, e.g. a postcode, town, city, or area name.
  value      String
  label      String?
  /// Optional serving radius in kilometers when the area is radius-based.
  radiusKm   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, value])
  @@index([businessId])
  @@map("service_areas")
}

/// Business opening hours (FEATURES §12).
model BusinessHour {
  id          String    @id @default(cuid())
  businessId  String
  weekday     Weekday
  /// Start of the first range, e.g. "08:00".
  startTime   String
  /// End of the last range, e.g. "18:00".
  endTime     String
  /// Multiple non-overlapping ranges can be modeled with separate rows per business/day.
  orderIndex  Int       @default(0)
  closed      Boolean   @default(false)
  emergency   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekday, orderIndex])
  @@index([businessId])
  @@map("business_hours")
}

/// Business knowledge entries (FEATURES §13).
/// `isActive` = Published (true) / Draft (false); `archivedAt` set = archived
/// and hidden from the dashboard list, so a draft is never an archive.
model KnowledgeEntry {
  id         String             @id @default(cuid())
  businessId String
  question   String
  answer     String
  type       KnowledgeEntryType @default(FAQ)
  category   String             @default("FAQ")
  tags       String[]           @default([])
  isActive   Boolean            @default(true)
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("knowledge_entries")
}
