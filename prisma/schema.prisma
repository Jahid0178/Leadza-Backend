// AI Lead Response Agent — initial schema (auth + tenancy foundation)
// Doc ref: agent.md §12 (Database), §6 (Authorization), §Platform Administration

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform-level role. Separate from business membership (agent.md §Platform Administration).
enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

/// Business membership role (agent.md §6).
enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum PriceType {
  FIXED
  FROM
  FREE
  CUSTOM
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum KnowledgeEntryType {
  FAQ
  BUSINESS
}

/// Lead lifecycle (FEATURES §15, agent.md §19). The backend owns the
/// transition table between these — the frontend may never jump states.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFYING
  QUALIFIED
  BOOKED
  WON
  LOST
  SPAM
  CANCELLED
}

/// Where a lead originated (FEATURES §16). Lets businesses measure which
/// channels generate results.
enum LeadSource {
  WEBSITE
  WHATSAPP
  EMAIL
  SMS
  FACEBOOK
  INSTAGRAM
}

/// How soon the customer needs help (FEATURES §17 example: "Urgency: High").
enum LeadUrgency {
  LOW
  MEDIUM
  HIGH
}

/// Conversation lifecycle (FEATURES §19, §31). The backend owns the
/// transitions between these — the frontend may never jump states.
enum ConversationStatus {
  AI_ACTIVE
  HUMAN_REQUESTED
  HUMAN_ACTIVE
  CLOSED
}

/// Channel a conversation arrived on (FEATURES §19, §38).
enum ConversationChannel {
  WEBSITE
  WHATSAPP
  EMAIL
  SMS
  FACEBOOK
  INSTAGRAM
}

/// Who wrote a message (FEATURES §20).
enum MessageSender {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String?
  platformRole   PlatformRole @default(USER)
  status         UserStatus   @default(ACTIVE)
  emailVerified  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships BusinessMember[]
  assignedConversations Conversation[] @relation("ConversationAssignee")

  @@map("users")
}

model Business {
  id         String         @id @default(cuid())
  name       String
  /// Free-text business type ("Plumber", "Electrician", …) — FEATURES §8.
  type       String?
  website    String?
  phone      String?
  email      String?
  address    String?
  description String?
  /// Presentation settings so the platform works in any country (§15, §30).
  /// ISO 4217 currency used to format money (lead budget, service prices).
  currency   String         @default("GBP")
  /// BCP-47 locale used to format dates, times and numbers.
  locale     String         @default("en-GB")
  /// IANA timezone used to render timestamps in the business's local time.
  timezone   String         @default("Europe/London")
  /// Coordinates from the chosen Nominatim suggestion (null for typed-only addresses).
  latitude   Float?
  longitude  Float?
  status     BusinessStatus @default(ACTIVE)
  /// Set when the owner finishes the onboarding flow; null = resume it (§9).
  onboardingCompletedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  members   BusinessMember[]
  services  Service[]
  areas     ServiceArea[]
  hours     BusinessHour[]
  knowledge KnowledgeEntry[]
  customers Customer[]
  leads     Lead[]
  conversations Conversation[]

  @@map("businesses")
}

/// Verified multi-tenancy link: user ↔ business (agent.md §6, §13).
model BusinessMember {
  id         String     @id @default(cuid())
  businessId String
  userId     String
  role       MemberRole
  createdAt  DateTime   @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

/// A service the business offers (FEATURES §10).
model Service {
  id          String     @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Float?
  priceType   PriceType  @default(FIXED)
  duration    Int?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@index([businessId])
  @@map("services")
}

/// A place the business serves (FEATURES §11).
model ServiceArea {
  id         String   @id @default(cuid())
  businessId String
  /// Normalized label, e.g. a postcode, town, city, or area name.
  value      String
  label      String?
  /// Optional serving radius in kilometers when the area is radius-based.
  radiusKm   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, value])
  @@index([businessId])
  @@map("service_areas")
}

/// Business opening hours (FEATURES §12).
model BusinessHour {
  id          String    @id @default(cuid())
  businessId  String
  weekday     Weekday
  /// Start of the first range, e.g. "08:00".
  startTime   String
  /// End of the last range, e.g. "18:00".
  endTime     String
  /// Multiple non-overlapping ranges can be modeled with separate rows per business/day.
  orderIndex  Int       @default(0)
  closed      Boolean   @default(false)
  emergency   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekday, orderIndex])
  @@index([businessId])
  @@map("business_hours")
}

/// A person who enquired about the business's services (FEATURES §14).
/// The same customer may have multiple leads over time; find-or-create is
/// keyed on (businessId, phone) or (businessId, email).
model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  postcode   String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads    Lead[]
  conversations Conversation[]

  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("customers")
}

/// A potential customer enquiry (FEATURES §15, agent.md §19–20).
/// Status transitions are validated in the backend against the lifecycle
/// table — the frontend may never jump a lead to an arbitrary state.
model Lead {
  id         String     @id @default(cuid())
  businessId String
  customerId String
  /// Optional: the enquiry may name no specific service yet.
  serviceId  String?
  status     LeadStatus @default(NEW)
  source     LeadSource @default(WEBSITE)
  urgency    LeadUrgency?
  /// Free-text town/city the job is at (§15).
  location   String?
  postcode   String?
  /// Budget the customer mentioned, in the business's currency (§15, §17).
  budget          Float?
  /// Preferred appointment date/time as captured (§15, §17).
  preferredDate DateTime?
  preferredTime String?
  /// The customer's original message (agent.md §20).
  customerMessage String?
  /// Rule-based score 0-100 (§18, step 23); null until scored.
  leadScore  Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@map("leads")
}

/// Business knowledge entries (FEATURES §13).
/// `isActive` = Published (true) / Draft (false); `archivedAt` set = archived
/// and hidden from the dashboard list, so a draft is never an archive.
model KnowledgeEntry {
  id         String             @id @default(cuid())
  businessId String
  question   String
  answer     String
  type       KnowledgeEntryType @default(FAQ)
  category   String             @default("FAQ")
  tags       String[]           @default([])
  isActive   Boolean            @default(true)
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("knowledge_entries")
}

/// A customer interaction thread (FEATURES §19, IMPLEMENTATION_PLAN step 15).
/// Every enquiry belongs to a conversation; the backend owns the status
/// transitions (AI ↔ human ↔ closed) — the frontend may never jump states.
model Conversation {
  id           String              @id @default(cuid())
  businessId   String
  customerId   String
  /// Optional: a conversation may exist before/without a lead.
  leadId       String?
  channel      ConversationChannel @default(WEBSITE)
  status       ConversationStatus  @default(AI_ACTIVE)
  /// Staff member who took the thread over (FEATURES §31 "Assigned staff").
  assignedToId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([leadId])
  @@map("conversations")
}

/// A single message in a conversation (FEATURES §20).
/// `aiGenerated` distinguishes AI replies from staff replies even though
/// both use sender-specific provenance.
model Message {
  id                String              @id @default(cuid())
  conversationId    String
  sender            MessageSender
  content           String
  channel           ConversationChannel @default(WEBSITE)
  aiGenerated       Boolean             @default(false)
  /// Provider id for idempotent channel webhooks (§36, §39); null for native.
  externalMessageId String?
  createdAt         DateTime            @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}
